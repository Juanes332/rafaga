# Solver settings (all optional except DATABASE_URL). Placeholders only.
DATABASE_URL=postgresql://rafaga:<password>@db:5432/rafaga
DATA_DIR=/data
# auto | cpu | gpu  (cpu forces NumPy even when a GPU is visible)
RAFAGA_DEVICE=auto
GPU_MEMORY_FRACTION=0.85
CPU_MAX_NODES_3D=3000000
LIGHT_LANE_CONCURRENCY=2
LOG_LEVEL=info
# Worker tuning (seconds)
POLL_INTERVAL_S=2
HEARTBEAT_INTERVAL_S=5
ORPHAN_TIMEOUT_S=60
CANCEL_KILL_AFTER_S=8
STARTUP_BENCHMARK=true
