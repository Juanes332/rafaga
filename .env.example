# Ráfaga - configuración. start crea .env a partir de este archivo y rellena los secretos.
# No subas .env al repositorio. No hay ninguna ubicación, ciudad ni dato de viento predefinido.

# --- Secretos (los genera start la primera vez; déjalos vacíos aquí) ---
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Puertos del host (vacío = el sistema elige uno libre; start los guarda aquí) ---
RAFAGA_WEB_PORT=
RAFAGA_API_PORT=

# --- Dispositivo de cálculo: auto, cpu o gpu ---
RAFAGA_DEVICE=auto

# --- Imágenes prediseñadas (opcional) ---
# Vacío = start construye las imágenes en local (por defecto). Si indicas un registro,
# start descarga <registro>/rafaga-api|solver|web:<versión> en vez de construir.
# Ejemplo: RAFAGA_IMAGE_REGISTRY=ghcr.io/mi-organizacion
RAFAGA_IMAGE_REGISTRY=
RAFAGA_VERSION=1.0.0

# --- Cuenta inicial opcional (si ambos están vacíos, se crea desde la pantalla de primer uso) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- API ---
JWT_TTL_MINUTES=720
TRUST_PROXY=false
RATE_LIMIT_ANON_PER_MINUTE=120
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TILES_PER_MINUTE=1500
MAX_UPLOAD_GEOMETRY_MB=100
MAX_UPLOAD_IMAGE_MB=25
ALTERNATIVES_LIMIT_DEFAULT=8
JOB_RETENTION_DAYS=90

# --- Servicios externos (únicas salidas a internet) ---
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_USER_AGENT=Rafaga/1.0 (local desktop app)
TILE_CACHE_MAX_MB=500
